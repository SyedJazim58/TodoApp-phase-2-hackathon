# ================================================================================================
# Frontend Environment Variables
# ================================================================================================
#
# IMPORTANT: Copy this file to .env.local and fill in the actual values
# DO NOT commit .env.local to version control - it contains secrets!
#
# Task: T073 - Comprehensive environment variable documentation
# Feature: 003-frontend-fullstack-integration
# Updated: 2026-02-09
# ================================================================================================

# ================================================================================================
# AUTHENTICATION CONFIGURATION
# ================================================================================================

# Better Auth Secret Key
# ----------------------
# CRITICAL: This secret MUST be identical in both frontend and backend .env files
#
# Purpose:
#   - Used by Better Auth to sign and verify JWT tokens
#   - Ensures secure communication between frontend and backend
#   - Mismatched secrets will cause authentication failures
#
# Security Requirements:
#   - Minimum 32 characters (recommended: 64+ characters)
#   - Use cryptographically secure random string
#   - Never reuse secrets across environments
#   - Rotate periodically (every 90 days recommended)
#
# Generation:
#   - Linux/Mac: openssl rand -hex 32
#   - Node.js: require('crypto').randomBytes(32).toString('hex')
#   - Online: https://generate-secret.vercel.app/32
#
# Example (DO NOT USE IN PRODUCTION):
BETTER_AUTH_SECRET=your-secure-secret-key-change-in-production-min-32-chars-use-openssl-rand-hex-32-to-generate

# ================================================================================================
# API CONFIGURATION
# ================================================================================================

# Backend API Base URL
# --------------------
# Purpose:
#   - Base URL for all backend API requests
#   - Used by API client to construct full endpoint URLs
#   - Must point to your FastAPI backend server
#
# Environment-specific values:
#   - Development (local):     http://localhost:8000
#   - Development (Docker):    http://backend:8000
#   - Staging:                 https://api-staging.yourdomain.com
#   - Production:              https://api.yourdomain.com
#
# Notes:
#   - Must include protocol (http:// or https://)
#   - Must NOT include trailing slash
#   - Must be accessible from user's browser (CORS configured on backend)
#   - HTTPS required in production for security
#
# NEXT_PUBLIC_ prefix: Makes this variable available in browser JavaScript
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Better Auth API URL
# -------------------
# Purpose:
#   - URL for Better Auth client to communicate with auth endpoints
#   - Typically identical to NEXT_PUBLIC_API_BASE_URL
#   - Used for login, signup, logout, and session management
#
# Notes:
#   - Should match your backend API URL in most cases
#   - Only change if you have a separate auth service
#   - Must be accessible from user's browser
#   - HTTPS required in production
#
# NEXT_PUBLIC_ prefix: Makes this variable available in browser JavaScript
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:8000

# ================================================================================================
# DEPLOYMENT CONFIGURATION (Optional)
# ================================================================================================

# Node Environment
# ----------------
# Purpose: Controls Next.js behavior and optimizations
# Values: development | production | test
# Default: development
#
# NODE_ENV=development

# Next.js Build Configuration
# ---------------------------
# Uncomment and configure for production builds
#
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_APP_NAME=Todo App
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ================================================================================================
# ANALYTICS & MONITORING (Optional)
# ================================================================================================

# Uncomment if you're using analytics or monitoring services
#
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ================================================================================================
# FEATURE FLAGS (Optional)
# ================================================================================================

# Enable/disable features in production
#
# NEXT_PUBLIC_ENABLE_DEBUG_MODE=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# ================================================================================================
# SECURITY NOTES
# ================================================================================================
#
# 1. NEVER commit .env.local or .env.production to version control
# 2. Use different secrets for each environment (dev, staging, prod)
# 3. Rotate secrets regularly (recommended: every 90 days)
# 4. Use environment variable management tools in production:
#    - Vercel: Environment Variables in project settings
#    - AWS: Systems Manager Parameter Store or Secrets Manager
#    - Docker: docker-compose.yml environment section or .env file
# 5. Ensure HTTPS in production for all API communications
# 6. Monitor for exposed secrets using tools like:
#    - git-secrets
#    - truffleHog
#    - GitHub secret scanning
#
# ================================================================================================
# GETTING STARTED
# ================================================================================================
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Generate a secure BETTER_AUTH_SECRET:
#    openssl rand -hex 32
#
# 3. Update BETTER_AUTH_SECRET with the generated value
#
# 4. Ensure the same BETTER_AUTH_SECRET is in backend/.env
#
# 5. Update API URLs for your environment:
#    - Development: http://localhost:8000 (default)
#    - Production: your actual backend URL (must use HTTPS)
#
# 6. Start the development server:
#    npm run dev
#
# 7. Verify configuration:
#    - Visit http://localhost:3000
#    - Check browser console for API connection errors
#    - Test signup/login functionality
#
# ================================================================================================
# TROUBLESHOOTING
# ================================================================================================
#
# Issue: "Authentication failed" or "Invalid token"
# Solution: Verify BETTER_AUTH_SECRET matches between frontend and backend
#
# Issue: "Network error" or "Failed to fetch"
# Solution: Check NEXT_PUBLIC_API_BASE_URL points to running backend
#
# Issue: CORS errors in browser console
# Solution: Ensure backend CORS configuration includes frontend URL
#
# Issue: Session not persisting across page refreshes
# Solution: Verify BETTER_AUTH_SECRET is correctly set in both environments
#
# For more help, see: /docs/TROUBLESHOOTING.md
# ================================================================================================
